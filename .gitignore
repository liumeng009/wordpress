# CURRENT host, so a committed copy would ship stale localhost URLs.
app/public/llms.txt

# ============================================================
# Custom plugins — INCLUDE these (must come AFTER ignore rules)
# ============================================================
!app/public/wp-content/plugins/xxdq-products/
!app/public/wp-content/plugins/xxdq-theme/
!app/public/wp-content/plugins/xxdq-pim/
!app/public/wp-content/plugins/xxdq-blocks/
!app/public/wp-content/plugins/xxdq-tools/

# ============================================================
# Empty config dirs at repo root
# ============================================================
conf/
logs/
scripts/

# ============================================================
# Local dev artifacts (one-off utilities, PDF extraction, image probes)
# Moved into _dev/ on 2026-09-27. Anything new under _dev/ stays ignored.
# ============================================================
_dev/
/*.py
/*.ps1
/*.sql
/*.pdf
/*.html
/*.tmp
/*.log
# Workspace-root .txt debug logs (data dumps, scan output, etc.)
/*.txt
# Keep README.md and SEO_TODO.md at the workspace root.
/!README.md
/!SEO_TODO.md

# ============================================================
# OS
# ============================================================
.DS_Store
Thumbs.db
